# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Postgres — matches docker-compose.yml defaults
POSTGRES_DB=aicounting
POSTGRES_USER=aicounting
POSTGRES_PASSWORD=aicounting
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Storage — local filesystem; unset to default to <repo>/media
MEDIA_ROOT=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Logging
ENV_TYPE=dev
LOG_DIR=logs

# Extraction providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
LANDING_AI_API_KEY=
LANDING_AI_ADE_MODEL=
DATALAB_API_KEY=
DATALABS_PIPELINE_ID=

# Classification
OPENAI_API_KEY=
OPENAI_PROJECT_ID=

# Azure AD SSO — removed in Phase 4, still read by authentication/ until then
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AUTH_REDIRECT_URI=
APP_REDIRECT_URI=
CUSTOMER_GROUP_ID=
ACCOUNTANT_GROUP_ID=
REVIEWER_GROUP_ID=
