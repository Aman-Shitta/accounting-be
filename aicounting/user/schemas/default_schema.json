{
  "name": "table_structure",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "schema": {
        "type": "array",
        "description": "An array of objects representing the structure of the table.",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique identifier for the object."
            },
            "description": {
              "type": "string",
              "description": "Description of the data item provided."
            },
            "gl_account": {
              "type": "string",
              "description": "General Ledger account number."
            },
            "gl_account_desc": {
              "type": "string",
              "description": "Description of the General Ledger account."
            },
            "confidence_score": {
              "type": "integer",
              "description": "Confidence score for the classification."
            }
          },
          "required": [
            "id",
            "description",
            "gl_account",
            "gl_account_desc",
            "confidence_score"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "schema"
    ],
    "additionalProperties": false
  }
}